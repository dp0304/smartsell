{
  "name": "smartsell",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "^24.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "setup:local": "node --import tsx apps/server/init-local.ts",
    "dev": "pnpm run dev:workspace",
    "dev:workspace": "node --watch --import tsx apps/server/dev.ts",
    "preview": "pnpm run preview:workspace",
    "preview:workspace": "node --import tsx apps/server/dev.ts preview",
    "build": "pnpm typecheck && pnpm exec turbo run build",
    "start": "pnpm --filter @smartsell/server start",
    "start:workspace": "pnpm start",
    "start:kernel": "pnpm --filter @smartsell/server start:kernel",
    "db:migrate": "pnpm --filter @smartsell/db migrate",
    "db:migrate:kernel": "pnpm --filter @smartsell/db migrate:kernel",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "requirements": "node scripts/requirements.mjs --check",
    "verify": "pnpm requirements && pnpm build && pnpm test --built-web",
    "verify:services": "bash scripts/verify-services.sh",
    "hub": "node --import tsx apps/server/hub.ts",
    "hub:init": "node --import tsx apps/server/hub-init.ts",
    "hub:service": "node --import tsx scripts/hub-service.mjs",
    "hub:update": "node --import tsx scripts/hub-update.mjs",
    "hub:doctor": "node --import tsx scripts/hub-doctor.mjs",
    "hub:export-legacy": "node --import tsx scripts/hub-export-legacy.mjs",
    "worker:release": "node --import tsx scripts/worker-release.mjs",
    "test:e2e-phase1": "node --import tsx --test tests/e2e-phase1/*.test.ts",
    "real-model-check": "node --import tsx scripts/real-model-check.mjs",
    "manual-client-check": "node --import tsx scripts/manual-client-check.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.4",
    "turbo": "^2.5.0",
    "@playwright/test": "^1.55.0"
  }
}
