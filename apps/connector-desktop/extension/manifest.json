{
  "manifest_version": 3,
  "name": "SmartSell Worker",
  "version": "0.3.0",
  "description": "讓這台電腦上的 SmartSell Worker 在你自己的 Chrome 裡，代你操作已登入的社群帳號。只操作它自己開的分頁。",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SmartSell Worker",
    "default_popup": "popup.html"
  }
}
