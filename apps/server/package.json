  "type": "module",
  "scripts": {
    "dev": "tsx watch src/command-main.ts",
    "start": "node --import tsx src/command-main.ts",
    "dev:commands": "pnpm dev",
    "dev:kernel": "tsx watch src/kernel-main.ts",
    "start:kernel": "tsx src/kernel-main.ts",
    "identity:configure": "tsx src/integration/configure-enterprise.ts",
