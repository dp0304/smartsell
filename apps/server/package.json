    "@smartsell/media-store": "workspace:*",
    "fastify": "^5.8.5",
    "pg": "^8.23.1",
    "saxes": "^6.0.0",
    "tsx": "^4.20.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1"
